MTN_MOMO_TARGET_ENVIRONMENT=sandbox

# API User credentials (générés via sandbox provisioning)
MTN_MOMO_API_USER_ID=4b406630-4c04-4ecd-abbb-891c7fc89e79
MTN_MOMO_API_KEY=82eb6efe3a944b128d721f337d436ade

# Subscription Keys par produit (depuis MTN Developer Portal)
