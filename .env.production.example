# Production Environment Configuration Template
# Rename this file to .env on your production server

# Database Configuration
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://admin:Admin123!%40%23@localhost:5432/cofinco

# Session Security
# Generate a strong secret with: openssl rand -base64 32
SESSION_SECRET=COFINCO_SECRET_2026_9f!K8@D2LxPQ7WZE

# Server Configuration
PORT=3000
NODE_ENV=production

# ===== MTN SMS API v2 =====
# Consumer Key et Secret depuis le portail MTN Developer
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SENDER_ID=COFIN
MTN_SMS_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token/accesstoken?grant_type=client_credentials
MTN_SMS_BASE_URL=https://api.mtn.com/v2/messages/sms/outbound
# Secret HMAC-SHA256 pour webhooks delivery receipt MTN
# Generer: openssl rand -hex 32
MTN_SMS_WEBHOOK_SECRET=

# ===== OTP Security =====
# Secret HMAC-SHA256 pour hashage des codes OTP (OBLIGATOIRE)
# Generer: openssl rand -hex 32
OTP_HMAC_SECRET=

# ===== Reconciliation =====
# Intervalle en minutes (defaut: 60)
BALANCE_RECONCILIATION_INTERVAL_MINUTES=60
# Auto-correction des ecarts mineurs (false en production recommande)
ENABLE_BALANCE_AUTO_CORRECTION=false

