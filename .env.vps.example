# ==========================================================
# MicroFlex — VPS Environment Variables (Option B)
# ==========================================================
# Ce fichier sert de TEMPLATE pour /opt/microflex/env/.env.runtime
# sur le VPS. En production, ce fichier est GÉNÉRÉ AUTOMATIQUEMENT
# par GitHub Actions à partir des GitHub Environment Secrets/Variables.
#
# Pour un test local ou setup initial, copiez ce fichier :
#   cp .env.vps.example /opt/microflex/env/.env.runtime
#   chmod 600 /opt/microflex/env/.env.runtime
# ==========================================================

# ===== Application =====
NODE_ENV=production
PORT=5000
APP_VERSION=latest

# ===== Registry (images Docker) =====
REGISTRY=ghcr.io
IMAGE_NAME=242darkman/microflex

# ===== Domain =====
DOMAIN=microflex-m.com

# ===== Database (PostgreSQL natif sur VPS) =====
# Format: postgresql://USER:PASSWORD@host.docker.internal:5432/DBNAME
# host.docker.internal permet aux containers Docker de joindre le PG natif
DATABASE_URL=postgresql://microflex_app:CHANGE_ME@host.docker.internal:5432/microflex

# ===== Redis =====
# Mot de passe pour Redis (container Docker) — openssl rand -base64 24
REDIS_PASSWORD=

# ===== Security Secrets =====
# REQUIRED — openssl rand -base64 32
SESSION_SECRET=
# REQUIRED — openssl rand -hex 32
OTP_HMAC_SECRET=
# REQUIRED — openssl rand -hex 32
OFFLINE_LIMITS_HMAC_KEY=

# ===== MinIO (Object Storage, container Docker) =====
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# URL publique pour les liens presignés (via Nginx)
MINIO_PUBLIC_ENDPOINT=https://microflex.bvsandbox.dev.com/storage

# ===== SMTP Email (Brevo) =====
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@microflex-m.com
SMTP_FROM_NAME=MICROFLEX
SMTP_SECURE=false

# ===== MTN SMS API v2 =====
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SENDER_ID=MICROFLEX
MTN_SMS_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token/accesstoken?grant_type=client_credentials
MTN_SMS_BASE_URL=https://api.mtn.com/v2/messages/sms/outbound
MTN_SMS_WEBHOOK_SECRET=

# ===== pawaPay (Mobile Money) =====
PAWAPAY_ENVIRONMENT=production
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_URL=https://microflex.bvsandbox.dev/api/webhooks/pawapay
PAWAPAY_WEBHOOK_PUBLIC_KEYS=
PAWAPAY_STATEMENT_PREFIX=MicroFlex
WEBHOOK_IP_VALIDATION=true

# ===== Accounting =====
GL_POSTING_MODE=STRICT
BALANCE_RECONCILIATION_INTERVAL_MINUTES=60
ENABLE_BALANCE_AUTO_CORRECTION=false

# ===== Monitoring =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ===== Logging =====
LOG_LEVEL=info

# ===== Scaling =====
APP_REPLICAS=3

# ===== Tenant & Feature Flags =====
TENANT_CONFIG_PATH=dist/tenant-config.json
# Les valeurs TENANT_* ci-dessous sont des DÉFAUTS DE DÉMARRAGE.
# Branding et feature flags sont surchargeables à chaud via l'API admin
# (/api/admin/tenant-branding, /api/admin/tenant-features) — voir docs/operations/livraison-enterprise.md
TENANT_ID=microflex
TENANT_NAME=MicroFlex
TENANT_FEATURE_SMS=true
TENANT_FEATURE_TONTINE=true
TENANT_FEATURE_MOBILE_MONEY=true
TENANT_FEATURE_FIELD_AGENTS=true

# Identité du déploiement (1 instance = 1 client)
# Réassignation exceptionnelle de la base à un autre tenant — un seul démarrage, puis retirer.
# TENANT_IDENTITY_REBIND=true

# Kill switch des surcharges dynamiques (feature flags + branding) — repli sur la config statique seule
# TENANT_OVERRIDES_STATIC_ONLY=true
