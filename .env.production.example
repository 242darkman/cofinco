# ==========================================================
# Cofinco — Environment Configuration
# ==========================================================
# This file is used by BOTH dev and prod (same variables).
# Copy to .env and fill in the values.
#
# DEV  : docker compose up -d
# PROD : docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# ==========================================================

# ===== Domain & TLS =====
DOMAIN=cofinco-m.com
ACME_EMAIL=admin@cofinco-m.com

# ===== Database =====
POSTGRES_USER=cofinco
POSTGRES_PASSWORD=
POSTGRES_DB=cofinco

# ===== Redis =====
REDIS_PASSWORD=

# ===== Session Security =====
# REQUIRED — openssl rand -base64 32
SESSION_SECRET=

# ===== OTP Security =====
# REQUIRED — openssl rand -hex 32
OTP_HMAC_SECRET=

# ===== Offline Limits Security =====
# REQUIRED — openssl rand -hex 32
# Signs offline agent limits (anti-tampering)
OFFLINE_LIMITS_HMAC_KEY=

# ===== MinIO (Object Storage) =====
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ===== SMTP Email (Brevo) =====
# Dashboard : https://app.brevo.com/settings/keys/smtp
# Clé SMTP : "Générer une nouvelle clé SMTP" → format xsmtpsib-...
# Port 587 + STARTTLS (SMTP_SECURE=false signifie STARTTLS, pas "pas de chiffrement")
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=a30b8b001@smtp-brevo.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cofinco-m.com
SMTP_FROM_NAME=COFINCO-M
SMTP_SECURE=false

# ===== MTN SMS API v2 =====
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SENDER_ID=COFIN
MTN_SMS_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token/accesstoken?grant_type=client_credentials
MTN_SMS_BASE_URL=https://api.mtn.com/v2/messages/sms/outbound
MTN_SMS_WEBHOOK_SECRET=

# ===== pawaPay (Mobile Money Aggregator) =====
# Dashboard: https://dashboard.pawapay.io
# REQUIRED — API token from pawaPay dashboard
PAWAPAY_ENVIRONMENT=production
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_URL=https://cofinco-m.com/api/webhooks/pawapay
PAWAPAY_WEBHOOK_PUBLIC_KEYS=
PAWAPAY_STATEMENT_PREFIX=Cofinco
WEBHOOK_IP_VALIDATION=true

# ===== Reconciliation =====
BALANCE_RECONCILIATION_INTERVAL_MINUTES=60
ENABLE_BALANCE_AUTO_CORRECTION=false
RECONCILIATION_INTERVAL_MINUTES=10
PENDING_THRESHOLD_MINUTES=10

# ===== Monitoring =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ===== Logging =====
LOG_LEVEL=info
APP_VERSION=1.0.0

# ===== Scaling (prod only) =====
# Number of stateless API replicas
APP_REPLICAS=2
# Docker image coordinates (prod only, dev builds locally)
# REGISTRY=ghcr.io
# IMAGE_NAME=owner/cofinco
