[Unit]
Description=Cofinco PostgreSQL Backup
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/opt/cofinco/scripts/vps/backup-db.sh
Environment=PG_DB=cofinco
Environment=PG_USER=cofinco_app
Environment=PG_HOST=localhost
Environment=PG_PORT=5432
Environment=BACKUP_DIR=/opt/cofinco/backups
Environment=RETENTION_DAILY=7
Environment=RETENTION_WEEKLY=4
StandardOutput=journal
StandardError=journal
# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
