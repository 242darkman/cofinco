# ==========================================================
# MicroFlex — local development defaults
# ==========================================================
# Copy to .env before running Docker Compose:
#   cp .env.dev .env
#
# These values are for local development only. Do not reuse them for
# preproduction or production deployments.
# ==========================================================

# ===== Domain & TLS =====
DOMAIN=localhost
ACME_EMAIL=admin@microflex.local
APP_URL=http://localhost:5001

# ===== Database =====
POSTGRES_USER=microflex
POSTGRES_PASSWORD=microflex
POSTGRES_DB=microflex

# ===== Redis =====
# Keep this alphanumeric: it is embedded in redis:// URLs.
REDIS_PASSWORD=redisdevpassword1234567890

# ===== Session Security =====
SESSION_SECRET=devsessionssecretonlyforlocalmicroflex123456

# ===== OTP Security =====
OTP_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== Offline Limits Security =====
OFFLINE_LIMITS_HMAC_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# ===== MinIO (Object Storage) =====
MINIO_ROOT_USER=microflexminio
MINIO_ROOT_PASSWORD=miniodevpassword1234567890
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ===== SMTP Email (Mailpit in Docker Compose admin profile) =====
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dev@microflex.local
SMTP_FROM_NAME=MICROFLEX-DEV
SMTP_SECURE=false

# ===== MTN SMS API v2 =====
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SENDER_ID=MICROFLEX
MTN_SMS_TOKEN_URL=
MTN_SMS_BASE_URL=
MTN_SMS_WEBHOOK_SECRET=

# ===== pawaPay (Mobile Money Aggregator) =====
PAWAPAY_ENVIRONMENT=sandbox
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_URL=http://localhost:5001/api/webhooks/pawapay
PAWAPAY_WEBHOOK_PUBLIC_KEYS=
PAWAPAY_STATEMENT_PREFIX=MicroFlex
WEBHOOK_IP_VALIDATION=false

# ===== Reconciliation =====
BALANCE_RECONCILIATION_INTERVAL_MINUTES=60
ENABLE_BALANCE_AUTO_CORRECTION=false
RECONCILIATION_INTERVAL_MINUTES=10
PENDING_THRESHOLD_MINUTES=10

# ===== KPI temps reel =====
# KPI_TIMEZONE=Africa/Brazzaville
# KPI_REFRESH_DEBOUNCE_MS=20000
# KPI_REFRESH_MIN_INTERVAL_MS=60000
# KPI_REFRESH_YEAR_INTERVAL_MS=600000
# KPI_REFRESH_CRON=*/10 * * * *

# ===== Monitoring =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ===== Logging =====
LOG_LEVEL=debug
APP_VERSION=dev
GL_POSTING_MODE=STRICT

# ===== Scaling (prod only) =====
APP_REPLICAS=1

# ===== Tenant =====
TENANT_CONFIG_PATH=config/tenants/microflex.json
