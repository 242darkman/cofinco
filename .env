# ==========================================================
# MicroFlex — DEV Environment Defaults
# ==========================================================
# Valeurs pré-remplies pour le développement local.
# Copier vers .env :  cp .env.dev .env
#
# En Docker : les variables sont surchargées par docker-compose.override.yml
# Sans Docker (npm run dev) : ces valeurs sont utilisées directement
# ==========================================================

# ===== Database =====
POSTGRES_USER=microflex
POSTGRES_PASSWORD=microflex_dev
POSTGRES_DB=microflex

# ===== Redis =====
REDIS_PASSWORD=redis_dev

# ===== Session Security =====
SESSION_SECRET=dev-session-secret-not-for-production-use-32chars
OTP_HMAC_SECRET=dev-otp-hmac-secret-not-for-production-use-64chars-long-enough
OFFLINE_LIMITS_HMAC_KEY=dev-offline-limits-hmac-key-not-for-production

# ===== MinIO (Object Storage) =====
# En Docker : docker-compose.override.yml surcharge MINIO_ENDPOINT → http://minio:9000
# Sans Docker : utilise localhost ci-dessous
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_REGION=us-east-1
BUCKET_PUBLIC_NAME=public-assets
BUCKET_PRIVATE_NAME=secure-docs

# ===== SMTP (defaults to Mailpit via docker compose --profile admin) =====
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dev@microflex.local
SMTP_FROM_NAME=COFIN-DEV
SMTP_SECURE=false

# ===== MTN SMS API v2 =====
# Laisser vide en dev (pas d'envoi réel de SMS)
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SENDER_ID=COFIN
MTN_SMS_TOKEN_URL=
MTN_SMS_BASE_URL=
MTN_SMS_WEBHOOK_SECRET=

