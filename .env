# Token pour vérifier les webhooks (généré aléatoirement)
#MTN_MOMO_CALLBACK_TOKEN=359340c8d04efcb237eb44adae5786111708cec3b8d04cfe73ce7f0bd2a530cf

# Options
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_COUNTRY=NL

# ===== MTN SMS API v2 =====
# Consumer Key et Secret depuis le portail MTN Developer (https://developer.mtn.com)
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
# Sender ID enregistré auprès de MTN (affiché comme expéditeur du SMS)
MTN_SMS_SENDER_ID=COFIN
# URLs API MTN (ne pas modifier sauf changement d'environnement)
MTN_SMS_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token/accesstoken?grant_type=client_credentials
MTN_SMS_BASE_URL=https://api.mtn.com/v2/messages/sms/outbound
# Secret HMAC-SHA256 pour vérifier les webhooks de delivery receipt MTN
# Générer: openssl rand -hex 32
MTN_SMS_WEBHOOK_SECRET=

# ===== SMTP Email (TurboSMTP) =====
# Utiliser les API Keys (Consumer Key / Consumer Secret) plutôt que le mot de passe du compte
SMTP_HOST=pro.eu.turbo-smtp.com
SMTP_PORT=587
SMTP_USERNAME=be64f15745aaefc5ea57c0e0ba50d415
SMTP_PASSWORD=cvdUIxXyM9uHtqQSrAeVbaDWT0JwlKC8
SMTP_FROM_EMAIL=brandon242dev@gmail.com
SMTP_FROM_NAME=COFIN&CO-M
SMTP_SECURE=false

# ===== OTP Security =====
# Secret HMAC-SHA256 pour le hashage des codes OTP (obligatoire en production)
# Générer: openssl rand -hex 32
OTP_HMAC_SECRET=dev-otp-hmac-secret-change-in-production

# ===== Airtel Money Congo =====
# Environnement: uat, staging, production
AIRTEL_ENV=uat
# Base URL:
# - UAT/Staging: https://openapiuat.airtel.cg
# - Production: https://openapi.airtel.cg
AIRTEL_BASE_URL=https://openapiuat.airtel.cg

# OAuth2 Credentials (obtenus via portail Airtel Partner)
AIRTEL_CLIENT_ID=votre_client_id
AIRTEL_CLIENT_SECRET=votre_client_secret

# PIN pour transactions (4 chiffres, sera chiffré RSA avant envoi)
AIRTEL_PIN=4550

# Localisation Congo Brazzaville
AIRTEL_COUNTRY=CG
AIRTEL_CURRENCY=XAF

# Callback URL - En localhost: laisser vide
# Pour tests avec vrais webhooks: utiliser ngrok (ex: https://abc123.ngrok.io/api/webhooks/airtel)
# En production: HTTPS obligatoire (ex: https://cofinco.com/api/webhooks/airtel)
AIRTEL_CALLBACK_URL=
# Secret HMAC-SHA256 partagé avec Airtel pour vérifier les webhooks (obligatoire en prod)
AIRTEL_CALLBACK_HMAC_SECRET=

# Signing (chiffrement payload pour Disbursements V3)
# En UAT: false (optionnel)
# En Production: true (obligatoire)
AIRTEL_SIGNING_ENABLED=false

# Timeouts (en ms)
AIRTEL_REQUEST_TIMEOUT=30000
# Buffer avant expiration du token pour refresh anticipé (en ms)
AIRTEL_TOKEN_REFRESH_BUFFER=60000

# Retry
AIRTEL_MAX_RETRIES=3
AIRTEL_RETRY_DELAY_MS=1000

# Cache TTL pour la clé RSA publique (en ms)
# 24h par défaut, 12h recommandé en production
AIRTEL_ENCRYPTION_KEY_CACHE_TTL=86400000

# ===== Monitoring Stack (Grafana + Prometheus) =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ===== Logging =====
LOG_LEVEL=trace
APP_VERSION=1.0.0-dev
NODE_ENV=development
