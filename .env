# ==========================================================
# Cofinco — DEV Environment Defaults
# ==========================================================
# Valeurs pré-remplies pour le développement local.
# Copier vers .env :  cp .env.dev .env
#
# En Docker : les variables sont surchargées par docker-compose.override.yml
# Sans Docker (npm run dev) : ces valeurs sont utilisées directement
# ==========================================================

# ===== Database =====
POSTGRES_USER=cofinco
POSTGRES_PASSWORD=cofinco_dev
POSTGRES_DB=cofinco

# ===== Redis =====
REDIS_PASSWORD=redis_dev

# ===== Session Security =====
SESSION_SECRET=dev-session-secret-not-for-production-use-32chars
OTP_HMAC_SECRET=dev-otp-hmac-secret-not-for-production-use-64chars-long-enough

# ===== MinIO (Object Storage) =====
# En Docker : docker-compose.override.yml surcharge MINIO_ENDPOINT → http://minio:9000
# Sans Docker : utilise localhost ci-dessous
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_REGION=us-east-1
BUCKET_PUBLIC_NAME=public-assets
BUCKET_PRIVATE_NAME=secure-docs

# ===== SMTP (defaults to Mailpit via docker compose --profile admin) =====
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dev@cofinco.local
SMTP_FROM_NAME=COFIN-DEV
SMTP_SECURE=false

# ===== MTN SMS API v2 =====
# Laisser vide en dev (pas d'envoi réel de SMS)
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SENDER_ID=COFIN
MTN_SMS_TOKEN_URL=
MTN_SMS_BASE_URL=
MTN_SMS_WEBHOOK_SECRET=

# ===== MTN MoMo (Mobile Money) =====
# En dev : utiliser le sandbox MTN (https://momodeveloper.mtn.com)
# Laisser vide pour désactiver
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_API_USER_ID=4b406630-4c04-4ecd-abbb-891c7fc89e79
MTN_MOMO_API_KEY=82eb6efe3a944b128d721f337d436ade
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=8baed02a5f95451fa5479a51ff32d559
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=5703635bfd7341798d9ee40a1ce46e79
MTN_MOMO_CALLBACK_URL=https://kailee-fey-lillyana.ngrok-free.dev/api/webhooks/mtn
MTN_MOMO_CURRENCY=XAF
MTN_MOMO_COUNTRY=CG

# ===== Airtel Money Congo =====
# En dev : utiliser l'environnement UAT
# Laisser vide pour désactiver
AIRTEL_ENV=uat
AIRTEL_BASE_URL=https://openapiuat.airtel.cg
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_PIN=
AIRTEL_COUNTRY=CG
AIRTEL_CURRENCY=XAF
AIRTEL_CALLBACK_URL=
AIRTEL_CALLBACK_HMAC_SECRET=
AIRTEL_SIGNING_ENABLED=false
AIRTEL_REQUEST_TIMEOUT=30000
AIRTEL_TOKEN_REFRESH_BUFFER=60000
AIRTEL_MAX_RETRIES=3
AIRTEL_RETRY_DELAY_MS=1000
AIRTEL_ENCRYPTION_KEY_CACHE_TTL=86400000

# ===== Comptabilité =====
GL_POSTING_MODE=STRICT

# ===== Monitoring =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ===== Logging =====
LOG_LEVEL=debug
APP_VERSION=dev
