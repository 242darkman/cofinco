{
  "name": "microflex-monorepo",
  "version": "2.0.1",
  "description": "MicroFlex Monorepo",
  "author": "BV Corp",
  "type": "module",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "vite dev --port 5173",
    "dev": "mkdir -p .tmp && TMPDIR=.tmp NODE_ENV=development node --env-file=.env --import tsx apps/api/index.ts",
    "build": "node --import tsx script/build.ts",
    "start": "NODE_ENV=production node --env-file=.env dist/index.cjs",
    "check": "tsc",
    "db:push": "node --import dotenv/config node_modules/drizzle-kit/bin.cjs push",
    "db:generate": "node --import dotenv/config node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --import dotenv/config node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --import dotenv/config --import tsx seeds/seed-prod.ts",
    "db:seed:dry-run": "node --import dotenv/config --import tsx seeds/seed-prod.ts -- --dry-run",
    "db:seed:force": "node --import dotenv/config --import tsx seeds/seed-prod.ts -- --force",
    "db:validate": "node --env-file=.env --import tsx scripts/validate-seed.ts",
    "db:clean-dead-letters": "node --env-file=.env --import tsx scripts/clean-dead-letter-jobs.ts",
    "db:clean-dead-letters:force": "node --env-file=.env --import tsx scripts/clean-dead-letter-jobs.ts -- --force",
    "audit:integrity": "node --env-file=.env --import tsx scripts/audit-integrity.ts",
    "gl:coverage": "node --env-file=.env --import tsx scripts/generate-gl-coverage.ts",
    "gl:contracts": "vitest run tests/contracts/gl-accounting-contracts.test.ts",
    "diagnose:balance": "node --env-file=.env --import tsx scripts/diagnose-balance-issues.ts",
    "monitor:gl": "node --env-file=.env --import tsx scripts/monitor-gl-strict.ts",
    "monitor:gl:alert": "node --env-file=.env --import tsx scripts/monitor-gl-strict.ts --alert",
    "cleanup:logs": "node --env-file=.env --import tsx scripts/cleanup-logs.ts",
    "cleanup:logs:dry-run": "node --env-file=.env --import tsx scripts/cleanup-logs.ts --dry-run",
    "security:audit": "node scripts/security/audit-dependencies.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "docker:test": "docker compose --profile test run --rm test-unit",
    "docker:test:e2e": "docker compose --profile test run --rm test-e2e"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie": "^0.6.0",
    "@types/cookie-signature": "^1.1.2",
    "@types/jspdf": "^1.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.0.0",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "date-fns": "^3.6.0",
    "isomorphic-dompurify": "^2.35.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "node-mocks-http": "^1.17.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17",
    "workbox-background-sync": "^7.4.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0",
    "turbo": "^2.5.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "connect-redis": "^7.1.1",
    "redis": "^4.7.0"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.23.0",
    "workbox-build": {
      "glob": "^13.0.0",
      "source-map": "0.7.4"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=24.0.0"
  }
}
