# ==========================================================
# Cofinco — DEV Environment Defaults
# ==========================================================
# Valeurs pré-remplies pour le développement local.
# Copier vers .env :  cp .env.dev .env
# ==========================================================

# ===== Database =====
POSTGRES_USER=cofinco
POSTGRES_PASSWORD=cofinco_dev
POSTGRES_DB=cofinco

# ===== Redis =====
REDIS_PASSWORD=redis_dev

# ===== Session Security =====
SESSION_SECRET=dev-session-secret-not-for-production-use-32chars
OTP_HMAC_SECRET=dev-otp-hmac-secret-not-for-production-use-64chars-long-enough

# ===== MinIO (Object Storage) =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ===== SMTP (defaults to Mailpit via docker compose --profile admin) =====
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dev@cofinco.local
SMTP_FROM_NAME=COFIN-DEV
SMTP_SECURE=false

# ===== Monitoring =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ===== Logging =====
LOG_LEVEL=debug
APP_VERSION=dev
