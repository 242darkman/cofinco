# ===== MTN MoMo (Sandbox) =====
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox

# API User credentials (générés via sandbox provisioning)
MTN_MOMO_API_USER_ID=5d913976-f4f7-4603-80b0-34c8ac79e94a
MTN_MOMO_API_KEY=f450439fca38464f986d7139288d0535

# Subscription Keys par produit (depuis MTN Developer Portal)
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=8baed02a5f95451fa5479a51ff32d559
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=5703635bfd7341798d9ee40a1ce46e79

# Callback URL - En localhost: laisser vide (utiliser /api/payments-test/simulate-webhook)
# Pour tests avec vrais webhooks: utiliser ngrok (ex: https://abc123.ngrok.io/api/webhooks/mtn)
MTN_MOMO_CALLBACK_URL=
# Token pour vérifier les webhooks (généré aléatoirement)
MTN_MOMO_CALLBACK_TOKEN=4db421505222e861cd75a689c5a24dc8daaa3d5d5d802b5c27bb7c1a558de768

# Options
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_COUNTRY=NL

# ===== Airtel Money Congo =====
# Environnement: uat, staging, production
AIRTEL_ENV=uat
# Base URL:
# - UAT/Staging: https://openapiuat.airtel.cg
# - Production: https://openapi.airtel.cg
AIRTEL_BASE_URL=https://openapiuat.airtel.cg

# OAuth2 Credentials (obtenus via portail Airtel Partner)
AIRTEL_CLIENT_ID=votre_client_id
AIRTEL_CLIENT_SECRET=votre_client_secret

# PIN pour transactions (4 chiffres, sera chiffré RSA avant envoi)
AIRTEL_PIN=4550

# Localisation Congo Brazzaville
AIRTEL_COUNTRY=CG
AIRTEL_CURRENCY=XAF

# Callback URL - En localhost: laisser vide
# Pour tests avec vrais webhooks: utiliser ngrok (ex: https://abc123.ngrok.io/api/webhooks/airtel)
# En production: HTTPS obligatoire (ex: https://cofinco.com/api/webhooks/airtel)
AIRTEL_CALLBACK_URL=
# Secret HMAC-SHA256 partagé avec Airtel pour vérifier les webhooks (obligatoire en prod)
AIRTEL_CALLBACK_HMAC_SECRET=

# Signing (chiffrement payload pour Disbursements V3)
# En UAT: false (optionnel)
# En Production: true (obligatoire)
AIRTEL_SIGNING_ENABLED=false

# Timeouts (en ms)
AIRTEL_REQUEST_TIMEOUT=30000
# Buffer avant expiration du token pour refresh anticipé (en ms)
AIRTEL_TOKEN_REFRESH_BUFFER=60000

# Retry
AIRTEL_MAX_RETRIES=3
AIRTEL_RETRY_DELAY_MS=1000

# Cache TTL pour la clé RSA publique (en ms)
# 24h par défaut, 12h recommandé en production
AIRTEL_ENCRYPTION_KEY_CACHE_TTL=86400000
