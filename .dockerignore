# Version control
.git
.gitignore

# Environment files (secrets)
.env
.env.*
!.env.production.example

# Dependencies (rebuilt in Docker)
node_modules

# Build output (rebuilt in Docker)
dist

# GeoNames : fichiers volumineux téléchargés au runtime par l'init container
# (scripts/download-geonames.sh), inutiles dans le contexte de build.
# Les fichiers légers committés (admin1CodesASCII.txt, admin2Codes.txt, all.json,
# countryInfo.txt) restent inclus car nécessaires au seed et non re-téléchargés.
seeds/allCountries.txt
seeds/cities5000.txt
seeds/CG.txt
seeds/*.zip

# Development
.tmp
.vscode
.idea
*.swp
*.swo

# Documentation
*.md
!package.json

# Tests
coverage
playwright-report
test-results
**/__tests__
**/*.test.ts
**/*.spec.ts

# CI/CD
.github

# Monitoring config (mounted as volumes, not baked)
monitoring

# Infrastructure
infra
k8s
docker-compose*.yml
Dockerfile*

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs
