{
  "expo": {
    "name": "COFIN&CO",
    "slug": "cofinco-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cofinco",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cofinco.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Utilise la camera pour scanner les codes QR de paiement",
        "NSFaceIDUsageDescription": "Utilise Face ID pour securiser votre connexion",
        "NSLocationWhenInUseUsageDescription": "Utilise votre position pour le suivi des operations terrain",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Permet le suivi GPS continu pendant vos tournees terrain",
        "NSLocationAlwaysUsageDescription": "Permet le suivi GPS en arriere-plan pendant vos tournees",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.cofinco.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#047857",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser l'acces a la camera pour scanner les codes QR de paiement"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#047857"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permet le suivi GPS continu pendant vos tournees terrain",
          "locationAlwaysPermission": "Permet le suivi GPS en arriere-plan pendant vos tournees",
          "locationWhenInUsePermission": "Utilise votre position pour le suivi des operations terrain",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0f172a"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
