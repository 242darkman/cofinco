# ==========================================================
# MicroFlex — Environment Configuration
# ==========================================================
# This file is used by BOTH dev and prod (same variables).
# Copy to .env and fill in the values.
#
# DEV  : docker compose up -d
# PROD : docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# ==========================================================

# ===== Domain & TLS =====
DOMAIN=microflex.bvsandbox.dev
ACME_EMAIL=admin@microflex.com

# ===== Database =====
POSTGRES_USER=microflex
POSTGRES_PASSWORD=microflex
POSTGRES_DB=microflex

# ===== Redis =====
REDIS_PASSWORD=

# ===== Session Security =====
# REQUIRED — openssl rand -base64 32
SESSION_SECRET=

# ===== OTP Security =====
# REQUIRED — openssl rand -hex 32
OTP_HMAC_SECRET=

# ===== Offline Limits Security =====
# REQUIRED — openssl rand -hex 32
# Signs offline agent limits (anti-tampering)
OFFLINE_LIMITS_HMAC_KEY=

# ===== MinIO (Object Storage) =====
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ===== SMTP Email (Brevo) =====
# Dashboard : https://app.brevo.com/settings/keys/smtp
# Clé SMTP : "Générer une nouvelle clé SMTP" → format xsmtpsib-...
# Port 587 + STARTTLS (SMTP_SECURE=false signifie STARTTLS, pas "pas de chiffrement")
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=a30b8b001@smtp-brevo.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@microflex.com
SMTP_FROM_NAME=MICROFLEX-M
SMTP_SECURE=false

# ===== MTN SMS API v2 =====
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SENDER_ID=MICROFLEX
MTN_SMS_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token/accesstoken?grant_type=client_credentials
MTN_SMS_BASE_URL=https://api.mtn.com/v2/messages/sms/outbound
MTN_SMS_WEBHOOK_SECRET=

# ===== pawaPay (Mobile Money Aggregator) =====
# Dashboard: https://dashboard.pawapay.io
# REQUIRED — API token from pawaPay dashboard
PAWAPAY_ENVIRONMENT=production
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_URL=https://microflex.bvsandbox.dev/api/webhooks/pawapay
PAWAPAY_WEBHOOK_PUBLIC_KEYS=
PAWAPAY_STATEMENT_PREFIX=MicroFlex
WEBHOOK_IP_VALIDATION=true

# ===== Reconciliation =====
BALANCE_RECONCILIATION_INTERVAL_MINUTES=60
ENABLE_BALANCE_AUTO_CORRECTION=false
RECONCILIATION_INTERVAL_MINUTES=10
PENDING_THRESHOLD_MINUTES=10

# ===== KPI temps réel =====
# Rafraîchissement automatique des snapshots KPI (période courante).
# Défauts sûrs si absents — ne définir que pour ajuster la cadence.
# Debounce après un événement financier (ms)
# KPI_REFRESH_DEBOUNCE_MS=20000
# Intervalle minimal entre deux recalculs globaux (ms)
# KPI_REFRESH_MIN_INTERVAL_MS=60000
# Intervalle minimal de recalcul de la vue annuelle (ms)
# KPI_REFRESH_YEAR_INTERVAL_MS=600000
# Cron filet de sécurité (expression cron, défaut : toutes les 10 min)
# KPI_REFRESH_CRON=*/10 * * * *

# ===== Monitoring =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ===== Logging =====
LOG_LEVEL=info
APP_VERSION=1.0.0

# ===== Scaling (prod only) =====
# Number of stateless API replicas
APP_REPLICAS=2
# Docker image coordinates (prod only, dev builds locally)
# REGISTRY=ghcr.io
# IMAGE_NAME=owner/microflex

# ===== Tenant =====
# La configuration métier du tenant (identité, branding, feature flags) ne vit
# JAMAIS en variables d'environnement. Source de vérité :
#   1. le fichier de config du client (embarqué dans son image Docker),
#   2. les surcharges dynamiques en base via l'API admin
#      (/api/admin/tenant-branding, /api/admin/tenant-features).
# Voir docs/operations/livraison-enterprise.md
TENANT_CONFIG_PATH=dist/tenant-config.json


# Identité du déploiement (1 instance = 1 client)
# Réassignation exceptionnelle de la base à un autre tenant — un seul démarrage, puis retirer.
# TENANT_IDENTITY_REBIND=true

# Kill switch des surcharges dynamiques (feature flags + branding) — repli sur la config statique seule
# TENANT_OVERRIDES_STATIC_ONLY=true
